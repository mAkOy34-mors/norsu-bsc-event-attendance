DB_ENGINE=mysql
DB_NAME=qrproject
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Switch to SQLite by changing:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3

# App security (required for production)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev

# Set True only after regenerating all printed QR codes
QR_REQUIRE_SIGNATURE=False

# ---------------- CACHING & RATE LIMITING ----------------
# Redis connection for shared cache + rate-limit counters (recommended in
# production, e.g. Render Key Value). Leave empty to use local memory cache.
# REDIS_URL=redis://default:password@host:port

# Cache lifetimes in seconds
CALENDAR_CACHE_TIMEOUT=60
LOOKUPS_CACHE_TIMEOUT=60

# Set False to disable all rate limits (e.g. for load testing)
RATELIMIT_ENABLE=True

# Header that carries the real client IP behind a proxy/load balancer
# (Render: HTTP_X_FORWARDED_FOR). Leave empty for direct connections.
# RATELIMIT_IP_META_KEY=HTTP_X_FORWARDED_FOR

# ---- Sessions ----
# Minutes of inactivity before a login session expires (default 480 = 8h).
# SESSION_TIMEOUT_MINUTES=480
# True (default): closing the browser ends the session (shared kiosks/phones).
# False: the cookie above survives browser restarts.
# SESSION_EXPIRE_ON_BROWSER_CLOSE=True
